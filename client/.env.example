# ProSync client — environment template
#
# Copy to `.env` for local development:
#   cp .env.example .env
#
# IMPORTANT: Vite inlines these values into the bundle at BUILD time, not at
# runtime. Changing one in your host's dashboard does nothing until you
# trigger a fresh build. On Vercel that means redeploying, not restarting.
#
# Equally important: everything here ships to the browser in plain text.
# Only ever put public values in a VITE_ variable — never an API secret.

# Origin of the ProSync API, with NO trailing slash and NO /api suffix.
#   local:      http://localhost:5001
#   production: https://prosync-api.onrender.com
VITE_API_URL=https://prosync-1-9rv7.onrender.com

# Google OAuth client id (public by design — it's visible in the login flow).
# Must match the server's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
