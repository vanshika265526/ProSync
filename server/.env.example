# ProSync API — environment template
#
# Copy to `.env` for local development. In production set these in your host's
# dashboard (Render → Environment), never in a committed file.
#
#   cp .env.example .env
#
# NEVER commit the real .env. It is already in .gitignore.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Render injects PORT automatically — leave it unset there.
PORT=5001

# 'production' enables the strict CORS allowlist. Anything else is treated
# as development and origins are not enforced.
NODE_ENV=development

# MongoDB Atlas connection string.
# Atlas → Database → Connect → Drivers. Remember to URL-encode any special
# characters in the password (@ becomes %40, # becomes %23, and so on).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/prosync?retryWrites=true&w=majority

# Signs every auth token. Use a long random string — regenerate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this invalidates all existing sessions.
JWT_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Frontend origin
# ---------------------------------------------------------------------------

# Where the browser app is served from. Drives both the CORS allowlist and
# the invite/referral links in outgoing email, so it must be the FRONTEND
# URL, not the API's. Comma-separated to allow several origins at once.
#   CLIENT_URL=https://prosync.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Allow any *.vercel.app origin, so branch and PR preview deploys can call
# the API without being added to CLIENT_URL one by one.
# Convenient for staging; leave false for a production-only API.
ALLOW_VERCEL_PREVIEWS=false

# ---------------------------------------------------------------------------
# Email (Nodemailer) — powers invites and the support form
# ---------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# For Gmail this is an App Password, not your account password.
# Requires 2FA: https://myaccount.google.com/apppasswords
SMTP_PASS=your-app-password

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------

# From Google Cloud Console → APIs & Services → Credentials.
# Must be the SAME id as the client's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=6867086221-fdpv0jvnmpg0ii8kpq8r2m6k1fkpiabd.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# GitHub integration (optional)
# ---------------------------------------------------------------------------

# Personal Access Token. Without one the GitHub API is capped at 60
# requests/hour per IP — shared across every user on the server, so the
# integration will rate-limit quickly in production. With a token: 5,000/hour.
# Create at https://github.com/settings/tokens (classic).
#   - public repos only -> no scopes needed
#   - private repos     -> tick "repo"
GITHUB_TOKEN=

# How often the background sync re-checks connected repositories (minutes).
# Set to 0 to disable background polling entirely.
GITHUB_SYNC_INTERVAL_MINUTES=3
