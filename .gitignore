# --- Secrets ---
# Broad on purpose: any .env variant is ignored EXCEPT .env.example, which is
# the committed template. A narrow rule is how server/.env got committed in
# the first place.
.env
.env.*
!.env.example
client/.env
server/.env

dist/
build/
out/

.DS_Store
Thumbs.db

.vscode/
.idea/

npm-debug.log*
yarn-debug.log*
yarn-error.log*